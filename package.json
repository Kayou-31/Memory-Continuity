{
  "name": "@dsh-external/dsh-memory-continuity",
  "version": "0.2.0-dev.3",
  "description": "Memory-Continuity：独立人物连续性、长期记忆、分层条件注入与人工成长审阅",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/rp-plugin.d.ts",
  "files": [
    "lib",
    "src",
    "ui",
    "scripts/build.mjs",
    "tsconfig.json",
    "SOURCE-MANIFEST.json",
    "UPSTREAM.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/rp-plugin.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "BSD-3-Clause",
  "author": "Kayou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kayou-31/dsh-ultra-rp-memory.git"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --emitDeclarationOnly false",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "evaluate:fixture": "node scripts/benchmarks/rp-memory.mjs --mode fixture --corpus benchmarks/rp/golden.jsonl --output fixture-report.json",
    "evaluate:life": "node scripts/benchmarks/person-life.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  }
}
