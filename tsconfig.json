{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": [
      "node"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "lib/types",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}
